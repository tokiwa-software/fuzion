check_type_pars =>

  # in a type parameter constraint
  a(HM: container.hash_map fuzion unit) is

  # NYI: BUG: not shown yet
  # in a choice generic
  b : choice unit (container.hash_map fuzion unit) is

  # in a result type
  c container.hash_map fuzion unit => abstract

  # in a result type of an argument
  d (e container.hash_map fuzion unit) unit =>

  # same as above but the violation is _nested_ in the Sequence feature

  aa(HM: Sequence (container.hash_map fuzion unit)) is

  # NYI: BUG: not shown yet
  bb : choice unit (Sequence (container.hash_map fuzion unit)) is

  cc Sequence (container.hash_map fuzion unit) => abstract

  dd (e Sequence (container.hash_map fuzion unit)) unit =>
