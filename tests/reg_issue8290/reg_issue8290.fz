#
#  Source code of Fuzion test reg_issue8290
#
# -----------------------------------------------------------------------

# the call target lookup for inheritance call `test.this.bla` in `child2`
# failed.
#
reg_issue8290 =>

  # the example from #8290 with `child3` added as a plain reference

  test(A : Any, B : Any) is

    inner(C : Any) is

      child1 : bla f64 is

        public redef as_string String => "child1 is $(child1.this.type)"

      child2 : test.this.bla f32 is

        public redef as_string String => "child2 is $(child2.this.type)"

      child3 : Any is

        public redef as_string String => "child3 is $(child3.this.type)"

    bla(D : numeric) is


  say <| test i32 unit .inner void .child1
  say <| test i32 unit .inner void .child2
  say <| test i32 unit .inner void .child3
