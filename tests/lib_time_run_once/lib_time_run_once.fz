# tests for time.Clock.run_once using a stopped clock as effect handler
#
lib_time_run_once =>

  # a clock that is stopped at `now`, `sleep` adds the requested
  # duration to `slept`
  #
  # NOTE: must be `ref`: `env` returns a copy of a value type effect, so
  # updates of `slept` would be lost.
  #
  stopped_clock(now time.instant) ref : time.Clock is

    slept := concur.atomic u64 .new 0

    public redef read time.instant =>
      now

    public redef sleep(d time.duration) unit =>
      slept.write (slept.read + d.nanos)


  ms(n u64) => time.duration.ms n

  base := time.Nano.env.read
  t0   := base + ms 10

  (stopped_clock t0).instate_self ()->

    # call `run_once` for instant `t`, print result, whether `code` ran
    # and the total duration slept so far
    #
    run(name String, t time.instant) =>
      ran := concur.atomic u64 .new 0
      res := stopped_clock.env.run_once t ()->
        ran.write 1
      slept := time.duration.ns stopped_clock.env.slept.read
      say "$name: result $res, ran $(ran.read), slept $(slept.as_string time.time_unit.ms)"

    run "future" (base + ms 15)
    run "now"    t0
    run "past"   (base + ms 5)
