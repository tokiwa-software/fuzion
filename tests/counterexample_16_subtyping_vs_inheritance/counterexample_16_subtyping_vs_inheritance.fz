#  Source code of Fuzion test counterexample_16_subtyping_vs_inheritance
#
# -----------------------------------------------------------------------

# A redefinition must accept every argument accepted by the original feature.
# Narrowing `go` from `Base` to `Sub` would allow a `Base` argument to reach a
# `Sub`-specific operation, so Fuzion rejects the redefinition.
counterexample_16_subtyping_vs_inheritance is

  Base ref is
  Sub ref : Base is

  A ref is
    go(x Base) unit => say "A.go"

  B ref : A is
    redef go(x Sub) unit => say "B.go"  # 1. should flag an error: argument must stay Base
