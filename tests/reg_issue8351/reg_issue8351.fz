#  Source code of Fuzion test reg_issue8351
#
# -----------------------------------------------------------------------

reg_issue8351 =>

  printed := mut 0

  print_limit : flow.exception_tag is
  unprintable : flow.exception_tag is

  print_trice(x Any) =>
    flow.exception print_limit
      .on ()->
        if printed >= 3 then
          (flow.exception print_limit).env.cause (error "printed 3 times")
        else
          say x.as_string
          printed <- printed+1
      .or_else ()->
          say "printed 3 times already"

  x(str option String) is
    public redef as_string String =>
      str.or_else ((flow.exception unprintable).env.cause (error "unprintable"))

  print(v x) =>
    flow.exception unprintable
      .on ()->
        print_trice v
      .or_else ()->
        say "unprintable"

  print (x "ok")
  print (x nil)
  print (x "ok")
  print (x "ok")
