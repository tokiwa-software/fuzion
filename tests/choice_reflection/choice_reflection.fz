# Test for choice reflection fucntions like `choice.tag` and `choice.apply`
#
choice_reflection =>

  chck(msg String, res, expected _ : property.equatable) =>
    say "$(res = expected ? "PASS $msg: got $res" : "FAIL $msg: got $res expected $expected")"

  # checking `tag`
  chck "tag" (id (choice bool i64 u8 void String) true             ).tag 0
  chck "tag" (id (choice bool i64 u8 void String) 42               ).tag 1
  chck "tag" (id (choice bool i64 u8 void String) "bla".utf8.first!).tag 2
  # chck "tag" (id (choice bool i64 u8 void String) void           ).tag 3 # -- impossible to create `void`
  chck "tag" (id (choice bool i64 u8 void String) "hi"             ).tag 4

  f(a choice bool i64 u8 void String) =>
    "tag is "+a.tag+" for $a"

  chck "tag and as_string in call to f" (f "böa"            ) "tag is 4 for böa"
  chck "tag and as_string in call to f" (f true             ) "tag is 0 for true"
  chck "tag and as_string in call to f" (f 42               ) "tag is 1 for 42"
  chck "tag and as_string in call to f" (f "bla".utf8.first!) "tag is 2 for 98"
  chck "tag and as_string in call to f" (f "hi"             ) "tag is 4 for hi"

  # basic bool types
  chck "true .tag      " (true .tag      ) 1
  chck "true .as_string" (true .as_string) "true"
  chck "false.tag      " (false.tag      ) 0
  chck "false.as_string" (false.as_string) "false"

  # basic option types
  chck "(option String \"bla\").tag      " ((option String "bla").tag      ) 0
  chck "(option String \"bla\").as_string" ((option String "bla").as_string) "bla"
  chck "(option String nil    ).tag      " ((option String nil  ).tag      ) 1
  chck "(option String nil    ).as_string" ((option String nil  ).as_string) "--nil--"
  chck "(option i64 42 ).tag      " ((option i64 42 ).tag      ) 0
  chck "(option i64 42 ).as_string" ((option i64 42 ).as_string) "42"
  chck "(option i64 nil).tag      " ((option i64 nil).tag      ) 1
  chck "(option i64 nil).as_string" ((option i64 nil).as_string) "--nil--"

  # tags of `void` mixed with `i32`/`unit`/`nil` types
  chck "id (choice void void void i32 void void unit nil void void) 42   .tag" (id (choice void void void i32 void void unit nil void void) 42   .tag) 3
  chck "id (choice void void void i32 void void unit nil void void) 42   .as_string" $(id (choice void void void i32 void void unit nil void void) 42  ) "42"
  chck "id (choice void void void i32 void void unit nil void void) unit .tag" (id (choice void void void i32 void void unit nil void void) unit .tag) 6
  chck "id (choice void void void i32 void void unit nil void void) unit .as_string" $(id (choice void void void i32 void void unit nil void void) unit) "unit"
  chck "id (choice void void void i32 void void unit nil void void) nil  .tag" (id (choice void void void i32 void void unit nil void void) nil  .tag) 7
  chck "id (choice void void void i32 void void unit nil void void) nil  .as_string" $(id (choice void void void i32 void void unit nil void void) nil ) "--nil--"

  # tags of `unit` mixed with `void` types
  chck "id (choice unit void void) unit .tag" (id (choice unit void void) unit .tag) 0
  chck "id (choice void unit void) unit .tag" (id (choice void unit void) unit .tag) 1
  chck "id (choice void void unit) unit .tag" (id (choice void void unit) unit .tag) 2

  # tags of `option nil`, i.e, `choice nil nil'
  chck "id (Sequence nil) [nil] .first.tag:" (id (Sequence nil) [nil] .first.tag) 0   # option nil that exists
  chck "id (Sequence nil) []    .first.tag:" (id (Sequence nil) []    .first.tag) 1   # option nil that does not exist

  # tags of mixed types
  chck "id (choice unit String nil (Sequence i64) concur) unit    .tag" (id (choice unit String nil (Sequence i64) concur) unit    .tag) 0
  chck "id (choice unit String nil (Sequence i64) concur) 'str'   .tag" (id (choice unit String nil (Sequence i64) concur) "str"   .tag) 1
  chck "id (choice unit String nil (Sequence i64) concur) nil     .tag" (id (choice unit String nil (Sequence i64) concur) nil     .tag) 2
  chck "id (choice unit String nil (Sequence i64) concur) [1,2,4] .tag" (id (choice unit String nil (Sequence i64) concur) [1,2,4] .tag) 3
  chck "id (choice unit String nil (Sequence i64) concur) concur  .tag" (id (choice unit String nil (Sequence i64) concur) concur  .tag) 4

  # tags of only unit types
  chck "id (choice unit nil concur) unit   .tag" (id (choice unit nil concur) unit   .tag) 0
  chck "id (choice unit nil concur) nil    .tag" (id (choice unit nil concur) nil    .tag) 1
  chck "id (choice unit nil concur) concur .tag" (id (choice unit nil concur) concur .tag) 2

  # test with impossible option
  q(o option (choice void)) =>
    o ? c choice void => $c.tag
      | nil           => "nil"

  chck "impossible option" (q nil) "nil"

  # test `option nil`
  test(s Sequence nil) =>
    o := s.first
    o.apply (T,v -> "$T $v tag:$(o.tag)")

  chck "option nil !ok" (test []   ) "nil --nil-- tag:1"
  chck "option nil ok!" (test [nil]) "nil --nil-- tag:0"

  test2(s Sequence nil) =>
    o := s.first
    test2a nil nil _ o

  test2a(A, B type, C type : choice A B, v C) =>
    match v
      A => "matches A: $v type $C $(v.tag)"
      B => "matches B: $v type $C $(v.tag)"

  chck "option nil !ok via generic call" (test2 []   ) "matches B: --nil-- type option nil 1"
  chck "option nil ok! via generic call" (test2 [nil]) "matches A: --nil-- type option nil 0"

  # more tag tests via calls:

  blub(x choice void String nil (Sequence i64) unit) =>
    "$(x.tag): " + match x
      String     => "StringYeahYeah!"
      nil        => "nil"
      s Sequence => "Sequence $s"
      unit       => "unit"
      void        =>

  blob(x choice void String nil (option (Sequence i64)) unit) =>
    "$(x.tag): " + match x
      String   => "StringYeahYeah!"
      nil      => "nil"
      s option => "option Sequence $s"
      unit     => "unit"
      void     =>

  chck "blub" (blub "hi"     ) "1: StringYeahYeah!"
  chck "blub" (blub nil      ) "2: nil"
  chck "blub" (blub [1,2,3,4]) "3: Sequence [1, 2, 3, 4]"
  chck "blub" (blub unit     ) "4: unit"

  chck "blob" (blob "hi"     ) "1: StringYeahYeah!"
  chck "blob" (blob nil      ) "2: nil"
  chck "blob" (blob [1,2,3,4]) "3: option Sequence [1, 2, 3, 4]"
  chck "blob" (blob unit     ) "4: unit"

  # example code from `choice.apply` comement:

  # A feature callable on any choice type with two parameters
  #
  reflect_on_choice(X, Y type,
                    C type : choice X Y,
                    c C)
  =>
    c.apply T,v->
      if T : numeric then
        say "c is numeric $v, c² is $(v*v)"
      else if T : String then
        say "c is String '$v' length $(v.codepoint_count)"
      else
        say "c is of type $T value $v"

  # NYI: ENHANCEMENT: #7791 better type inference should avoid the explicit types here:
  reflect_on_choice false_ true_ bool true
  reflect_on_choice String nil (option String) "hi!"
  reflect_on_choice String nil (option String) nil
  reflect_on_choice (num.complex f64) (num.fraction i64) (choice (num.complex f64) (num.fraction i64)) (num.complex -1.0 1.0)
  reflect_on_choice (num.complex f64) (num.fraction i64) (choice (num.complex f64) (num.fraction i64)) (3⁄4)
