#  Source code of Fuzion test counterexample_02_covariant_containers
#
# -----------------------------------------------------------------------

# The covariant-container counterexample relies on a mutable container being
# treated covariantly.  Fuzion arrays are invariant, so a mutable `array i32`
# cannot be used as an `array Any` and the unsoundness is rejected here.
counterexample_02_covariant_containers is

  cars array i32 := [1, 2, 3]
  vehicles array Any := cars  # 1. should flag an error: mutable arrays are invariant
