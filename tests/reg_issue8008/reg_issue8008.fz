reg_issue8008 =>
  am : concur.atomic_mutate is
  bm : concur.blocking_mutate is
  cm : mutate is

  am
    .and unit _ bm
    .and cm
    .call ()->
      x := am.env.var String "hello"
      y := bm.env.var String ", world"
      z := cm.env.var String "!"

      bm.env.exclusive ()->
        say "$(x.get)$(y.get)$(z.get)"
