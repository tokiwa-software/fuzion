functions is

    # this test uses Any.hash_code, which no longer exists. So we provide it here:
    Any.hash_code =>
      for
        r := 4711, r *° 257 +° c.as_i64
        c in Any.this.as_string.utf8
      else
        r

    y(f ()->i64) is {}
    x0(f0 Function i64 Any i64) =>
      say "here 1x0---------------"
      r1 i64 := f0.call "hallo" 3
      say "here 2x0---------------"
      r2 i64 := 42
      # r2 := f0 "welt" 5
      say "here 3x0---------------"
      say "$r1  $r2"
      say "here 1x0 done---------------"

    x(f0 (Any, i64) -> i64) =>
      say "here 1x---------------"
      r1 i64 := f0.call "hallo" 3
      g (Any, i64) -> i64 := f0;
      r2 i64 := g.call "welt"  4
      # i64 r3 := f0    ("hola",5);
      # i64 r4 := g     ("mundo",5);
      # r5 := f0("Konnichiwa sekai!",7);
      say "$r1  $r2"

    say "here 1a---------------"
    x ((o, i) ->
        say "in function 1: $o"
        i*i
      )

    say "here 1b---------------"
    # all of these are equivalent:
#    x ((o, i) -> o.hash_code + i)
#    x (fun (o, i) -> o.hash_code + i)
#    x (fun (o, i) { o.hash_code + i})
    x ((o, i) -> { o.hash_code + i })
    x ((o, i) -> { o.hash_code + i })  # implicit assignment to result from last expression

    say "here 1c---------------"
    x (_ : Binary i64 Any i64 is {
        public redef call(o Any, i i64) i64 =>
          say "in anonymous function: $o"
          o.hash_code + i
       })

    F ref : Binary i64 Any i64 is
        public redef call(o Any, i i64) i64 =>
          say "here F.call---------------"
          res := o.hash_code + i
          say "here F.call done---------------"
          res

    say "here x0 F---------------"
    x0 F
    say "here x0 (fun i64 (Any o, i64 i) { o.hash_code + i })---------------"
    x0 ((o, i) -> { o.hash_code + i })
    say "here x(F)---------------"
    x F

    f1(o Any, i i64) i64 =>
        say "here f1 o i !!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        o.hash_code + i
    say "here x0 (fun f1)---------------"
    x0 ((o, i)->f1 o i)
    say "here x (fun f1)---------------"
    x ((o, i)->f1 o i)
