reg_issue7791_type_infer_from_actual_type_par =>

  # code from issue #7791

  f(T type, S type : Sequence T) => say $T
  f _ (array unit)

  g(T type, S type : Sequence T, v S) => say $T
  g _ _ [unit]

  # some more variants:

  f1(S type : Sequence T, T type ) => say "f1: $T"
  f1 (array unit) _

  f2(T type, S type : Sequence T, v S) => say "f2: $T"
  f2 _ _ [unit]

  f3(T type, S type : Sequence T, O type : option i64) => say "f3: $T"
  f3 _ (array i64) (option i64)

  f4(T type, S type : Sequence T, O type : option T) => say "f4: $T"
  f4 _ (array u64) (option u64)
