#
#  Source code of Fuzion test counterexample_29_polymorphic_union_refinement
#
# -----------------------------------------------------------------------

# `ElementOrArray T` is a tagged union, so `identity` cannot mistakenly refine
# `T` to `array T` when `T` itself is `array i32`.  The `T` alternative stays
# tagged as `T`, and the recursive call returns the original array unchanged.
counterexample_29_polymorphic_union_refinement is

  ElementOrArray(T type) : choice T (array T) is

  or_singleton(T type, x ElementOrArray T) array T =>
    match x
      a array T => a
      e T => [e]

  identity(T type, x T) T =>
    xs := or_singleton T x
    xs[0]

  say (identity i32 42)
  say (identity (array i32) [3, 1, 4])
