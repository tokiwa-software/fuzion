#
#  Source code of Fuzion test counterexample_23_overdetermined_recursion
#
# -----------------------------------------------------------------------

# The constraints on `A` and `B` refer to each other, so satisfying `A T`
# would require `T` to satisfy both `B T` and `A T` indefinitely.  Fuzion
# reports that no concrete type argument can satisfy the cyclic constraints.
counterexample_23_overdetermined_recursion is

  A(T type : B T) is  # 1. should flag an error: cyclic constraint
  B(T type : A T) is

  x A i32 := A i32  # 2. should flag an error: i32 does not satisfy B i32
