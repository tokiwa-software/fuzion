# original lua code from rosettacode:
#
# function a(k,x1,x2,x3,x4,x5)
#   local function b()
#      k = k - 1
#      return a(k,b,x1,x2,x3,x4)
#    end
#     if k <= 0 then return x4() + x5() else return b() end
#  end
#
#  function K(n)
#    return function()
#      return n
#    end
#  end
#
#  print(a(10, K(1), K(-1), K(-1), K(1), K(0)))

man_or_boy is

  a(k i64, x1, x2, x3, x4, x5 () -> i64) i64 =>
    b =>
      set k := k - 1
      a k (()->b) x1 x2 x3 x4

    if (k ≤ 0) x4() + x5() else b
    # k <= 0 ? x4() + x5() : b

  # a(k i64, x1, x2, x3, x4, x5 fun () i64) => { b => { k = k - 1
  #                                                     a(k,fun b ,x1,x2,x3,x4)
  #                                                   }
  #                                              k <= 0 ? x4() + x5() : b
  #                                            }

  # a(k i64, x1, x2, x3, x4, x5 fun () i64) => k <= 0 ? x4() + x5() : b
  # a.b => { k = k - 1
  #          a(k,fun b ,x1,x2,x3,x4)
  #        }

  # K(n i64) => fun () i64 { n }
  # K(n i64) => fun i64 { n }
  # K(n i64) => fun () => n
  # K(n i64) => fun => n
  K(n i64) Function i64 => ()->n

  (0..8).for_each n->
    say "manorboy a($n) = $(a n K(1) K(-1) K(-1) K(1) K(0))"
