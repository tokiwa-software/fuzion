#  Source code of Fuzion test reg_issue4428
#
# -----------------------------------------------------------------------

# This used to crash with an `illegal this type` since `a.x` was changed to
# `void.this.x` or similar.
#
# For this simple case, I see no reason why this should not compile, but not in
# more complex cases, see #8262 for details.
#
f(x ()->T) =>
f ()->
  a is
    x => a
  a.x
