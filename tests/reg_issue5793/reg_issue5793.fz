# -----------------------------------------------------------------------
#
#  Tokiwa Software GmbH, Germany
#
#  Source code of Fuzion test reg_issue5793
#
# -----------------------------------------------------------------------

# This tests reflective functionilty of `choice` based on intrinsics
#
# This includes features like `as_string`, `property.equatable`, `property.orderable`,
# conversion to ordinal numbers, etc.
#
reg_issue5793 =>

  say ""
  say "--- testing ordinal of simple choice type: ---"
  say ""

  say (id (choice bool i64 u8 String) true             ).ordinal
  say (id (choice bool i64 u8 String) 42               ).ordinal
  say (id (choice bool i64 u8 String) "bla".utf8.first!).ordinal
  say (id (choice bool i64 u8 String) "hi"             ).ordinal

  f(a choice bool i64 u8 String) =>
    say "ordinal is "+a.ordinal+" for $a"

  f true
  f 42
  f "bla".utf8.first!
  f "hi"

  say ""
  say "--- testing ordinals of some common choice types: ---"
  say ""

  # bool is mapped to Java type `boolean` by the JVM backend:
  say "true .ordinal: $(true .ordinal) $(true ) expecting 1"
  say "false.ordinal: $(false.ordinal) $(false) expecting 0"

  # `option String` uses `null` to represent the `nil` case in the JVM backend:
  say "option String 'bla' .ordinal: $(option String "bla" .ordinal) $(option String "bla" ) expecting 0"
  say "option String nil   .ordinal: $(option String nil   .ordinal) $(option String nil   ) expecting 1"

  # `option i64` uses a `ordinal` field
  say "option i64 42  .ordinal: $(option i64 42  .ordinal) $(option i64 42  ) expecting 0"
  say "option i64 nil .ordinal: $(option i64 nil .ordinal) $(option i64 nil ) expecting 1"

  say ""
  say "--- testing ordinals choice with several `void` entries: ---"
  say ""

  # note that `void` entries will be removed from the ordinal numbering by the JVM backend, so we must make sure they are put back in correctly:

  say "id (choice unit void void) unit .ordinal $(id (choice unit void void) unit .ordinal) expecting 0"
  say "id (choice void unit void) unit .ordinal $(id (choice void unit void) unit .ordinal) expecting 1"
  say "id (choice void void unit) unit .ordinal $(id (choice void void unit) unit .ordinal) expecting 2"

  say "id (choice void void void i32 void void unit nil void void) 42   .ordinal: $(id (choice void void void i32 void void unit nil void void) 42   .ordinal) $(id (choice void void void i32 void void unit nil void void) 42  ) expecting 3"
  say "id (choice void void void i32 void void unit nil void void) unit .ordinal: $(id (choice void void void i32 void void unit nil void void) unit .ordinal) $(id (choice void void void i32 void void unit nil void void) unit) expecting 6"
  say "id (choice void void void i32 void void unit nil void void) nil  .ordinal: $(id (choice void void void i32 void void unit nil void void) nil  .ordinal) $(id (choice void void void i32 void void unit nil void void) nil ) expecting 7"

  say ""
  say "--- testing `option nil`, which is effectively `choice nil nil`, but it can have ordinals 0 and 1: ---"
  say ""

  say "id (Sequence nil) [nil] .first.ordinal: $(id (Sequence nil) [nil] .first.ordinal) expecting 0"
  say "id (Sequence nil) []    .first.ordinal: $(id (Sequence nil) []    .first.ordinal) expecting 1"

  say ""
  say "--- choice of unit types and ref types only are encoded using not ordinal field but special ref values by the C backend: ---"
  say ""

  say "id (choice unit String nil (Sequence i64) concur) unit    .ordinal $(id (choice unit String nil (Sequence i64) concur) unit    .ordinal) expecting 0"
  say "id (choice unit String nil (Sequence i64) concur) 'str'   .ordinal $(id (choice unit String nil (Sequence i64) concur) "str"   .ordinal) expecting 1"
  say "id (choice unit String nil (Sequence i64) concur) nil     .ordinal $(id (choice unit String nil (Sequence i64) concur) nil     .ordinal) expecting 2"
  say "id (choice unit String nil (Sequence i64) concur) [1,2,4] .ordinal $(id (choice unit String nil (Sequence i64) concur) [1,2,4] .ordinal) expecting 3"
  say "id (choice unit String nil (Sequence i64) concur) concur  .ordinal $(id (choice unit String nil (Sequence i64) concur) concur  .ordinal) expecting 4"

  say ""
  say "--- choice of only unit types are treated like an int type by the JVM backend: ---"
  say ""

  say "id (choice unit nil concur) unit   .ordinal $(id (choice unit nil concur) unit   .ordinal) expecting 0"
  say "id (choice unit nil concur) nil    .ordinal $(id (choice unit nil concur) nil    .ordinal) expecting 1"
  say "id (choice unit nil concur) concur .ordinal $(id (choice unit nil concur) concur .ordinal) expecting 2"

  say ""
  say "--- testing with void alternatives ---"
  say ""

  q(o option (choice void)) =>
    o ? c choice void => say c.ordinal
      | nil           => say "nil: $(o.ordinal) expecting 1"
  q nil

  say ""
  say "--- mix of void, several ref and several unit types ---"
  say ""

  blub(x choice void String nil (Sequence i64) unit) =>
    yap "$(x.ordinal): "
    match x
      String => say "StringYeahYeah!"
      nil => say "nil"
      s Sequence => say "Sequence $s"
      unit => say "unit"
      void =>

  say "----blub----"
  blub "hi"
  blub nil
  blub [1,2,3,4]
  blub unit

  say ""
  say "--- mix of void, one ref type, choice type and several unit types ---"
  say ""

  blob(x choice void String nil (option (Sequence i64)) unit) =>
    yap "$(x.ordinal): "
    match x
      String => say "StringYeahYeah!"
      nil => say "nil"
      s option => say "option Sequence $s"
      unit => say "unit"
      void =>

  say "----blob----"
  blob "hi"
  blob nil
  blob [1,2,3,4]
  blob unit
