# tests for time.Clock.stopwatch, time.Thread_Time and time.Process_Time
#
lib_time_cpu_time =>

  # a deterministic clock: the n-th read returns `start + n µs`
  #
  fake_clock(start time.instant, reads concur.atomic u64) : time.Clock is

    public redef read time.instant =>
      n := reads.read
      reads.write n+1
      start + time.duration.ms n

    public redef sleep(d time.duration) unit =>
      unit


  fc := fake_clock time.Nano.env.read (concur.atomic u64 .new 0)

  fc.instate_self ()->

    # stopwatch reads the clock exactly twice: before and after `f`
    #
    say (fake_clock.env.stopwatch ()->unit)

    r, d := fake_clock.env.stopwatch _ ()->42
    say "$r $d"

  # CPU time clocks can be read
  #
  _ := time.Thread_Time.env.read
  _ := time.Process_Time.env.read
  say "cpu time clocks are readable"
