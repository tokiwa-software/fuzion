# this tests if we can fool `fz` to take a different version of `tuple` or `unit` for its tuple
# syntax sugar:

# the original example from #8458

tuple             is say "hi!"
tuple(a,b,c void) is say "hi!"

yap "expecting (1,2,3): "; say (1,2,3)
yap "expecting unit: "; say ()

f(tuple_arg (unit, i32)) => say tuple_arg
g(tuple_arg ())          => say tuple_arg

yap "expecting (unit, 42): "; f (unit, i32 42)
yap "expecting unit: "; g unit
yap "expecting unit: "; g ()

# More tests for `unit`:

test_unit =>

  unit is say "*** error ***"

  yap "expecting unit: "; say ()
  yap "expecting unit: "; say (id ())
  yap "expecting unit: "; say (id () ())
  yap "expecting unit: "; say (type_as_value ())
  yap "expecting unit: "; say (type_of ())
  yap "expecting unit: "; say (type_of (id ()))
  yap "expecting unit: "; say (type_of (id () ()))
  yap "expecting Type: "; say (type_of (type_as_value ()))

test_unit