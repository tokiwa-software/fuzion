a(T type, v T) is
  u(F type : T->T, f F) => ignore (f v)
  v(f T->T)             => ignore (f v)

a "hi alice"   .u                o->o+"!"
a "hi bob"     .u String->String o->o+"!"
a "hi charlie" .v                o->o+"!"
