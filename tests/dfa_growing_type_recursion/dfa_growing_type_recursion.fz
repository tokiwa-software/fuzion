#  Tokiwa Software GmbH, Germany
#
#  Source code of Fuzion test dfa_growing_type_recursion
#
# -----------------------------------------------------------------------

# This recursion instantiates f with an ever-growing type argument:
#
#   f u8
#   f (Sequence u8)
#   f (Sequence (Sequence u8))
#   ...
#
# DFA must detect this and abort compilation instead of creating an unbounded
# number of monomorphized clazzes.

f(T type) =>
  f (Sequence T)

f u8
