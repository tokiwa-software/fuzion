# test the syntax of ternary ? : and match using single lines, multi lines
# and using expressions containing ':' and '|' operators.
#
test_ternary is

  a is
    ternary ? : (b, c Any) is say "a ? $b : $c"

  # single line ternary ? :
  _ := a ? { 3 } : { 4 }
  _ := a ? ( 3 ) : ( 4 )
  _ := a ?   3   :   4
  _ := a      ?   3   :   4

  # multi-line ternary ? :
  _ := (a ? 3
          : 4)
  _ :=
      a ? 3
        : 4

  # ternary with mid-term containing ':'
  _ :=  a ? (3 : ()->[4,5].as_list) : nil
  _ := (a ? (3 : ()->[4,5].as_list)
          : nil)
  _ := a ? say (3 : ()->[4,5].as_list) : say nil
  _ := (a ? say (3 : ()->[4,5].as_list)
          : say nil)

  x is
  y is
  f(c x | y) =>

    # single line ? | match
    c ? x => { f } | y => { g }
    c ? x => ( f ) | y => ( g )
    c ? x =>   f   | y =>   g
    c      ? x =>   f   | y =>   g

    # multi-line ? | match
    (c ? x => f
       | y => g)
    c       ? x => f
            | y => g

    # match with cases containing '|'
    _ :=  c ? x => (3 | 4) | y => (5 | 8)
    _ := (c ? x => (3 | 4)
            | y => (5 | 8))
    c ? x => say (3 | 4) | y => say (5 | 8)
    c ? x => say (3 | 4)
      | y => say (5 | 8)

    f => say "found x"
    g => say "found y"

  f x
  f y

  # nested ternary with r3 layout (conditions aligned, : at end of line)
  cond1 := false
  cond2 := false
  cond3 := false
  cond4 := false
  val1 := "v1"
  val2 := "v2"
  val3 := "v3"
  val4 := "v4"
  val5 := "v5"

  # r3 layout: conditions aligned, colons at end of lines
  r3 := cond1 ? val1 :
        cond2 ? val2 :
        cond3 ? val3 :
        cond4 ? val4
              : val5
  say r3

  # r4 layout: operators at start of lines, aligned
  r4 := cond1
          ? val1
          : cond2
          ? val2
          : cond3
          ? val3
          : cond4
          ? val4
          : val5
  say r4

  # r5 layout: cascading diagonal indentation
  r5 := cond1 ? val1 : cond2
                     ? val2 : cond3
                            ? val3 : cond4
                                   ? val4 : val5
  say r5

  # test with true condition to verify correct value selection
  true_cond := true
  r3_true := true_cond ? val1 :
             cond2 ? val2 :
             cond3 ? val3 :
             cond4 ? val4
                   : val5
  say r3_true

  r4_true := true_cond
               ? val1
               : cond2
               ? val2
               : cond3
               ? val3
               : cond4
               ? val4
               : val5
  say r4_true

  r5_true := true_cond ? val1 : cond2
                        ? val2 : cond3
                               ? val3 : cond4
                                      ? val4 : val5
  say r5_true
