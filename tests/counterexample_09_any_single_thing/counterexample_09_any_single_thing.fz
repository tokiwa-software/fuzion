#
#  Source code of Fuzion test counterexample_09_any_single_thing
#
# -----------------------------------------------------------------------

# The "Any (single) thing" counterexample tries to use a reference with two
# unconstrained type parameters as if the parameters could differ.  Fuzion
# requires both type arguments of `RWRef` to agree, so `RWRef A A` cannot be
# assigned to `RWRef A B`.
counterexample_09_any_single_thing is

  RWRef(A, B type) ref is
    put(x B) unit => abstract
    get A => abstract

  build(A type) RWRef(A, A) => abstract

  castit(A, B type, x B) A =>
    r RWRef(A, B) := build A  # 1. should flag an error: both type parameters must be A
    r.put x
    r.get
