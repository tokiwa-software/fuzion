# `Any` is Fuzion's top type and `void` is its bottom type.  Generic type
# parameters express universal quantification, so `identity` works for every
# type without requiring separate top/bottom/universal types in the source.
counterexample_08_some_kinds_of_anything is

  identity(T type, x T) T => x

  any Any := identity i32 42
  say any

  empty(T type, v void) T =>
    match v

  say "Any is top, void is bottom, and type parameters are universally quantified."
