lib_container_persistent_hash_map =>

  e := container.persistent_hash_map i64 String .empty
  a := e.put 1 "eins"
  b := a.put 2 "zwei"
  c := a.put 3 "drei"
  d := b.put 1 "one" .put 2 "two"

  say """
    e=$e
    a=$a
    b=$b
    c=$c
    d=$d"""


