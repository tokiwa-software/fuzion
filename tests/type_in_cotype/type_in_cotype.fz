type_in_cotype is

  type.some_feat =>
    say "hello from type_in_cotype"

  type.some_type(arg i32) : property.equatable is


    public redef type.equality(a, b some_type.this) bool =>

      # access the outer type of the cotype of some_type
      type_in_cotype.this.type.some_feat

      a.arg = b.arg




  # you try to use the cotype of this new type, e.g., by passing this type as a type parameter

  say (type_in_cotype.some_type 1 = type_in_cotype.some_type 1)
  say (type_in_cotype.some_type 1 = type_in_cotype.some_type 2)


type_in_cotype2 : type_in_cotype is


  redef type.some_feat =>
    say "hello from type_in_cotype2"

_ := type_in_cotype

# NYI: BUG: this should print hello from type_in_cotype2
_ := type_in_cotype2
