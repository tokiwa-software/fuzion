#  Source code of Fuzion test reg_issue8081
#
# -----------------------------------------------------------------------

# This used to cause a crash of `fz` since type parameter `get.M` was
# not resolved before `constraint()` was called on this feature and
# this was checked with a precondition.
#
reg_issue8081 =>

  mutate ! ()->
    get(a container.Mutable_Array2 codepoint (M : mutate)) =>
    get ((mutate.array2 codepoint).type.new 3 4 "0")
