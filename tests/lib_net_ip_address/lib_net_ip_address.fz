lib_net_ip_address =>

  ipv4_addr := "192.168.2.1"
  ipv6_addr := "2001:0db8:85a3:0000:0000:8a2e:0370:7334"

  for addr in [ipv4_addr, ipv6_addr] do
    check net.ip_address.from_string addr .as_string = addr
