#
#  Source code of Fuzion test counterexample_11_runtime_type_misinformation
#
# -----------------------------------------------------------------------

# A `choice` is a tagged union.  Unlike JVM/Scala/Flow erasure examples, the
# alternatives `Box i32` and `Box String` remain distinguishable at runtime,
# so matching cannot confuse an `i32` box with a `String` box.
counterexample_11_runtime_type_misinformation is

  Box(T type, v T) is

  Boxes : choice (Box i32) (Box String) is

  describe(b Boxes) String =>
    match b
      x Box i32 => "i32: $(x.v)"
      x Box String => "String: $(x.v)"

  say (describe (Box i32 42))
  say (describe (Box String "hello"))
