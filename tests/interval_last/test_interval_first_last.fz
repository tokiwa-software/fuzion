# -----------------------------------------------------------------------

# tests for interval.first and interval.last, see issue #7423


# --- last ---

# through is an element of the interval
say (u32 1 .. 10).last

# through is NOT an element: elements are 1,5,9, so last is 9 (not 10)
say (u32 1 .. 10 : 4).last

# degenerate interval with from = through
say (u32 5 .. 5).last

# negative step, through is an element: 10,7,4,1
say (i32 10 .. 1 : -3).last

# negative step, through is not an element: 10,6,2
say (i32 10 .. 1 : -4).last

# empty intervals, see the docstring of interval
say (interval 2 1 1).last
say (interval 1 2 -1).last

# large interval, must be O(1)
say (u32 1 .. 1000000).last


# --- first ---

say (u32 1 .. 10).first

say (u32 5 .. 5).first

# an empty interval has no first element either
say (interval 2 1 1).first
