reg_issue37 =>

  a(T type) is
    b : a b is                     # 1. should flag an error: `b` found in `a.b` and in `a`

  x is
    y : x is
      f(v z) => say "f"            # 2. should flag an error: `z` found in `x.y` and in `x`
    z is

  # qualified versions must work
  p(T type) is
    q : p p.this.q is
      say "ok in p.q"

  u is
    v : u is
      g(w u.v.this.k) => say "g"
      h(w u.this.k)   => say "h"
    k is

  _ := (p i32).q
  _ := u.v
