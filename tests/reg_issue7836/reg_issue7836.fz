#
#  Source code of Fuzion test reg_issue7836
#
# -----------------------------------------------------------------------

# This tests a tricky case of formal argument type inference from actual
# argument types when for part of the actual calls, the actual argument
# depends on its formal argument type.
#
reg_issue7836 =>

  # the original example from the issue:
  #
  dec14 =>

    input := [(71, 0,  12, -37),
              (31, 67, 53,  91),
              (53, 49, 76,  37)]
              .map ||||>robot

    robot(x,y,vx,vy) is
      move(n) =>
        robot (x+vx*n) (y+vy*n) vx vy

    part1 =>
      (1..4).map q->(input.map (.move 100) .count) .fold i64.product

    say "$part1"

  dec14

  # a simplified version
  #
  r(x) is
    m(n) => r x*n
  say <| (7 |> (x-> r x)).m 1

  # a simplified version, usling partial application
  #
  r1(x) is
    m(n) => r1 x*n
  say <| (7 |> r1).m 1

  # a variant with crossed dependencies between arguments
  #
  r2(x,y) is
    m(n) => r2 n*y x*n
  say <| ((6,7) ||> (i,j -> r2 i j)).m 1

  # a variant with crossed dependencies between arguments
  #
  r3(x,y) is
    m(n) => r3 n*y x*n
  say <| ((6,7) ||> r3).m 1
