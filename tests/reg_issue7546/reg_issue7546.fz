foo(K type, v type) is

my_test(K type : property.hashable, V type) =>
  m : mutate is
  m ! ()-> # remove this to get errors

    c := foo i32 String

    put is
    get is
    operation : choice put get rem is

    test(op operation, k K, v option V) =>

      say "[INFO] $op $k$(match v ? v => "=>$v" | _ => "")"

      match op
        put => unit
        get => unit

    test put 6 "six"
