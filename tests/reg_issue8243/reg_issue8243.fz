# This small example has syntax errors in a way to create an Impl with
# _expr==null that was dereferenced.
#
reg_issue8243 =>

  # original code causing a NullPointerExcep in Impl.java since _expr is null:

  public a (U match) is
  public b (T type,) : a T is

  # code adapted for new type parameter syntax

  public c (U match) is
  public d (T : Any,) : c T is
