lru_cache_test =>

  put is
  get is
  del is
  operation : choice put get del is
    public redef as_string String =>
      match operation.this
        put => "put"
        get => "get"
        del => "remove"

  original is
  reverse  is
  split    is
  ordering : choice original reverse split is


  # run the cache operation and return the result, additionally shows some debug output
  test(M type : mutate, K type : property.hashable, c container.LRU_Cache M K V, op operation, k K, ov option V) option V =>

    res := match op
      put =>  c.put k ov.or_panic
              nil
      get =>  c.get k
      del =>  c.remove k

    say "$op $k$(op ? put => "=>$ov" | * => " returned $res")"

    say "$c\n"
    res



  # put a range of elements into the cache, then run the given operation
  # in the given order and check the results
  #
  put_then_get_or_del(
    # capacity of the cache
    cap i64,

    # operation to run after putting elements (get or del)
    op operation,

    # order in which to run the operation
    op_order ordering) unit
  =>
    evictions i64 := 3
    start := 1
    end   := (cap+evictions)
    half  := end/2
    elems := start..end

    say "\ntesting cache with capacity $cap, expecting $evictions evictions"
    say "put keys from $elems, afterwards $op $(
      match op_order
        original => $elems
        reverse  => "$end..$start"
        split    => "$(half+1)..$end followed by $start..$half")\n"

    m : mutate is
    m ! ()->
      c := container.LRU_Cache m i64 String .new cap
      say "$c\n"

      for e in elems
          i in 0..
      do
        check (i != 0) ^ c.is_empty
        check (i < cap && c.size = i) || (i >= cap && c.size = cap)
        _ := test c put e "_$(e)_"

      exp_evicted := elems.take evictions

      op_elems := match op_order
                  original => elems
                  reverse  => elems.reverse
                  split    => (half+1..end).as_array ++ (start..half).as_array

      for i in op_elems do
        res := test c op i nil
        # make sure only non evicted elements return a value and check that it is correct
        check (res.ok && res.or_panic = "_$(i)_") ^ exp_evicted.contains i
        op ? del => {check (test c get i nil).is_nil} | * =>

      # get and del from empty cache
      check test c get -1 nil .is_nil
      check test c del -1 nil .is_nil

  for op in (id (array operation) [get, del]) do
    for cap in [1,2,3,6] do
      for ord in (id (array ordering) [original, reverse, split]) do
        put_then_get_or_del cap op ord



  # test updating existing values in the cache
  #
  # put elements -n..n, then change values from keys that are divisible by 2
  # afterwards check that all keys return the expected value
  #
  update_value(n i32) =>

    cap := n*2+1
    elems := -n..n

    m : mutate is
    m ! ()->
      c := container.LRU_Cache m i32 String .new cap
      say "$c\n"

      elems.for_each i->(ignore (test c put i "_$(i)_"))

      elems.filter %%2
          .for_each i->(ignore (test c put i "~$(i**2)~"))

      for i in elems do
        exp := i%%2 ?  "~$(i**2)~" : "_$(i)_"
        act := test c get i nil .or_panic
        check exp = act

  update_value 7



  # randomly get, put or remove elements, and compare against naive solution
  #
  random(capacity i64, steps i64, seed u64) unit =>

    key_range := capacity * 2
    val_range := 100

    Random.simple seed ()->
      m : mutate is
      m ! ()->

        # expected key value pairs
        exp_map := container.mutable_tree_map m i64 i64 .empty
        # expected order from mru to lru
        exp_ord := m.env.new (Sequence i64) []
        cache := container.LRU_Cache m i64 i64 .new capacity

        remove_exp(k i64) unit =>
          exp_ord <- exp_ord.filter (!=k)
          _ := exp_map.remove k

        evict_exp unit =>
          exp_ord.drop capacity
                 .for_each k->({yap ""; ignore (option i64) (exp_map.remove k)})
          exp_ord <- exp_ord.take capacity .as_list

        update_exp(k, v i64) unit =>
          remove_exp k
          exp_map.put k v
          exp_ord <- [k] ++ exp_ord
          evict_exp

        for i in 0..steps
            op := Random.env.next_i64 3
            k  := Random.env.next_i64 key_range
        do
          if i %% 1E3 then yap "." # progress indicator

          if op = 0       # put
            v := Random.env.next_i64 val_range
            update_exp k v
            cache.put k v

          else if op = 1  # get
            act := cache.get k
            exp := exp_map.get k
            check act = exp
            _ := exp.bind v->(update_exp k v)

          else            # remove
            act := cache.remove k
            exp := exp_map.get k
            check act = exp
            remove_exp k
    say ""

  random 1  1E1 42
  random 2  1E2 391367
  random 3  1E2 935059
  random 10 1E4 537241
