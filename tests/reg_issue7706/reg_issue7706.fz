# regression test for issue #7706: Calling `fixed` feature in outer feature ignores actual outer type
#
# Calling the `fixed` feature `q` from the inner feature `n.x` must use the
# actual outer type, so `m.n.x`, `b.n.x` and `a.n.x` print "m.q", "b.q", "a.q".
#
m is
  n is
    x =>
      q

  fixed q => say "m.q"

b : m is
  fixed q => say "b.q"
a : m is
  fixed q => say "a.q"

m.n.x
b.n.x
a.n.x
