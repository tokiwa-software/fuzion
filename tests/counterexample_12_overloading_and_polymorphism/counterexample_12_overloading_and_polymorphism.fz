# Fuzion does not overload features by argument type.  The two `compare_to`
# declarations below are therefore a duplicate-feature error instead of an
# overload set that could produce an inconsistent bridge method.
counterexample_12_overloading_and_polymorphism is

  compare_to(o Any) i32 => 0
  compare_to(o String) i32 => 0  # 1. should flag an error: no overloading by argument type
