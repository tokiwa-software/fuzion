#  Source code of Fuzion test reg_issue5266
#
# -----------------------------------------------------------------------

reg_issue5266 =>

  f(a   bool) is xyz => say "f xyz"
  g(a,b bool) is xyz => say "g xyz"

  ignore <| f true       # ok, parsed as call with one arg
              .xyz

  ignore <| g true       # ok
              true

  ignore <| g true       # ok
              true
            .xyz

  ignore <| g true       # ok
              true
              .xyz

  ignore <| g true       # fails, parsed as call with three args
              true
              .xyz
