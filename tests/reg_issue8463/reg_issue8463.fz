# test inheriting from features with open type parameters

reg_issue8463 is

  # the original examples from #8463

  test1 : tuple is

  test2 : tuple 3 is

  say test1
  say test2

  # some more tests

  test3 : tuple "hi" 3.14 unit (num.complex 2 3) is

  say test3

  test1_1 : test1 is
  test2_1 : test2 is
  test3_1 : test3 is

  say test1_1
  say test2_1
  say test3_1

  # some test using Function where the inheritance provides only actual type parameters, no value
  # arguemnts

  testA1 : Function i64 unit (option void) is

     public redef call(a unit, b option void) i64 =>
       r := "$a $b".byte_count
       say "$a $b $r"
       r

  say testA1
  say <| testA1.call unit nil

  # An another test with value arguments, but the open type parameter coming from outer features

  outer(A... : Any) is
    inner(v A...) is
      show => say "types: $A values $v"

