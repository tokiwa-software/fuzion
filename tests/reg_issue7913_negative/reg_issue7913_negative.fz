#
#  Source code of Fuzion test reg_issue7913_negative
#
# -----------------------------------------------------------------------

# Test that space separated actual arguments must be separated by white space
#
reg_issue7913_negative =>

  # number followed by string
  #
  _ := tuple 4711"a"                  # 1. should flag an error: no white space between actual arguments

  # string followed by parenthesized actual
  #
  _ := tuple "a"(3,4)                 # 2. should flag an error: no white space between actual arguments

  # parenthesized actual followed by number
  #
  _ := tuple (1)42                    # 3. should flag an error: no white space between actual arguments

  # two missing separators in one line
  #
  _ := tuple 4711 "a"(((("b"))))()    # 4. should flag an error: no white space between actual arguments

  # two parenthesized actuals
  #
  _ := tuple (1)(2) 3                 # 5. should flag an error: no white space between actual arguments

  # string followed by number in the middle of the list
  #
  _ := tuple 1 "a"2 3                 # 6. should flag an error: no white space between actual arguments
