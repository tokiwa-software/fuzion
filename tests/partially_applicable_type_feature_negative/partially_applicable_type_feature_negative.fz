# `t1ok` requires an argument, so `t1ok.of` can only be the type feature, the
# inner feature requires a value, e.g., `(t1ok "y").of`
t1ok(s String) is
  public redef as_string String => "t1ok($s)"
  public of(t String) t1ok => t1ok "$s/$t"
  public type.of(s String) t1ok => t1ok s

_ := "x" |> t1ok.of         # ok, type feature
_ := "x" |> (t1ok "y").of   # ok, inner feature

# `t1` can be called without arguments, so `t1.of` could be the inner feature
# or the type feature
t1 is
  public of(t String) t1 => t1
  public type.of(s String) t1 => t1

_ := "x" |> t1.of   # 1. should flag an error: inner feature or type feature?


# `of` needs two arguments, `|>` provides one
t2(s String) is
  public type.of(s, t String) t2 => t2 "$s$t"

_ := "x" |> t2.of   # 2. should flag an error: wrong number of arguments


# no function expected, so no partial application
t3(s String) is
  public type.of(s String) t3 => t3 s

_ := t3.of          # 3. should flag an error: missing argument


# `of` returns a function, but `of s` could also be partially applied
t4(s String) is
  public type.of Unary t4 String => x -> t4 "direct $x"
  public type.of(s String) t4 => t4 "partial $s"

_ := "x" |> t4.of        # 4. should flag an error: direct call or partial application?
_ := "x" |> t4.type.of   # 5. should flag an error: direct call or partial application? with explicit `.type`


# `of "z"` could be `of(s)` or partially applied `of(s, t)`
t5(s String) is
  public type.of(s String) t5 => t5 s
  public type.of(s, t String) t5 => t5 "$s$t"

_ := ["a"].map (t5.of "z")   # 6. should flag an error: direct call or partial application?

# `f "x" "y"` could be a direct call to `f(a, b)` returning a function or
# partially applied `f(a, b, c)`
t6(s String) is
  public type.f(a, b String) Unary t6 String =>
    x -> t6 "via type.f(a,b): $a $b $x"
  public type.f(a, b, c String) t6 => t6 "via type.f(a,b,c): $a $b $c"

_ := "z" |> (t6.f "x" "y")      # 7. should flag an error: direct or partial?
_ := ["z"].map (t6.f "x" "y")   # 8. should flag an error: direct or partial?

# `t7` can be called without arguments, so `t7.of` could be the inner feature
# `of` returning a function or partially applied type feature `of(s)`
t7 is
  public of Unary String String => x -> "via of: $x"
  public type.of(s String) String => "via type.of(s): $s"

_ := "x" |> t7.of               # 9. should flag an error: inner or type?

# same as `t7` with argument lists exchanged: type feature `of` returning a
# function or partially applied inner feature `of(s)`
t8 is
  public type.of Unary String String => x -> "via type.of: $x"
  public of(s String) String => "via of(s): $s"

_ := "x" |> t8.of               # 10. should flag an error: inner or type?

# `t9` can be called without arguments, so `t9.a` could be partially applied
# for the inner feature `a(v)` as well as for the type feature `a(v)`
t9 is
  public a(v i64) bool => v > 1
  public type.a(v i64) bool => v > 2

_ := [1, 2, 3].filter t9.a      # 11. should flag an error: inner or type?
