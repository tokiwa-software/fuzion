inference_choice_generics =>

  tree(T type) : choice nil T (Branch T) is

  Branch(T type, left, right tree T) ref is

  tree := (Branch
            (Branch
              (Branch $"A" "B")
              (Branch $"C" "D"))
            (Branch
              (Branch $"E" "F")
              (Branch $"G" nil)))

  print(t tree X) unit =>
    match t
      nil      => yap "."
      s X      => yap s
      b Branch => print b.left; print b.right

  print tree
  say ""

  # -----------------------------

  special_branch(T type, l, r tree T) : Branch T l r is

  tree2 := (special_branch
             (special_branch
               (Branch 42 67)
               (Branch 47 11))
             (Branch
               (special_branch 08 15)
               (special_branch 32 168)))

  # NYI: UNDER DEVELOPMENT: #8048 Do not call `print` while this issue is open
  if false
    print tree2
    say ""

  # -----------------------------

  Myref(T type) ref is

  myval               : Myref f32           is
  myval(T, U, V type) : Myref (tuple T U V) is

  f(U type,
    v choice nil (Myref U))
  =>
    say U

  f myval
  f (myval bool unit void)
