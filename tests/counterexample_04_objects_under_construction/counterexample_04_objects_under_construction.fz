#
#  Source code of Fuzion test counterexample_04_objects_under_construction
#
# -----------------------------------------------------------------------

# `a` is initialized before `b`, and its initializer reads `b` through `crash`.
# Fuzion detects the read of a field that has not been initialized yet, so the
# object-under-construction counterexample is rejected.
counterexample_04_objects_under_construction is

  Foo ref is
    a String := crash
    b String := "initialized"

    crash String =>
      say "b = '$b'"  # 1. should flag an error: field 'b' is read before initialization
      b

  f := Foo
  say f.a
