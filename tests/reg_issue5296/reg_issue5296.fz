# negative indentation cases from issue #5296

cond1 bool => true
cond2 bool => true
cond3 bool => true
cond4 bool => true
longcond2 bool => true

val1 := "value 1"
val2 := "value 2"
val3 := "value 3"
val4 := "value 4"
val5 := "value 5"

# '?' of chained ternary is not aligned with first '?' or ':'
_ := cond1 ? val1 :
      cond2 ? val2 :
     cond3 ? val3 :
             val4

# '?' is not indented deeper than its condition
_ := cond1
     ? val1
     : cond2
     ? val2
     : val3

# diagonal chain starts misaligned
_ := cond1 ? val1 : cond2
                 ? val2 : cond3
                        ? val3 : val4

# long condition makes the chained '?' misaligned
_ := cond1 ? val1 :
      longcond2 ? val2 :
      cond3 ? val3 :
              val4
