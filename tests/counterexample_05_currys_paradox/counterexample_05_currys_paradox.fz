#
#  Source code of Fuzion test counterexample_05_currys_paradox
#
# -----------------------------------------------------------------------

# This is the type-level Curry paradox: `F` is a `Curry` whose `r` applies its
# argument to itself.  Fuzion is not a total language, so it accepts this
# recursive type and program; evaluating `go` would diverge.  The test is
# compile-only so the recursion is not executed.
counterexample_05_currys_paradox is

  Curry ref is
    r(c Curry) i32 => abstract

  F ref : Curry is
    redef r(c Curry) i32 => c.r c

  go i32 =>
    c := F
    c.r c
