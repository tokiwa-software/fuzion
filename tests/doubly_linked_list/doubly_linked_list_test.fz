doubly_linked_list_test =>

  m : mutate is
  m ! ()->

    l := container.Doubly_Linked_List m i32 .empty

    test_add_frst(e i32) unit =>
      l.add_first e
      say """
        add first $e          length=$(l.length) contains($e)=$(l.contains e)
        $l
        $(l.as_array)
        """

    test_add_last(e i32) unit =>
      l.add_last e
      say """
        add last $e           length=$(l.length) contains($e)=$(l.contains e)
        $l
        $(l.as_array)
        """

    test_rem_frst_mtch(f i32->bool) =>
      say """
        remove_first_match=$(l.remove_first_match f) length=$(l.length)
        $l
        $(l.as_array)
        """

    test_rem_frst =>
      e := l.remove_first
      say """
        remove_first=$e       length=$(l.length) $(e ? i i32 => "contains($i)=$(l.contains i)" | * => "")
        $l
        $(l.as_array)
        """

    test_rem_last =>
      e := l.remove_last
      say """
        remove_last=$e        length=$(l.length) $(e ? i i32 => "contains($i)=$(l.contains i)" | * => "")
        $l
        $(l.as_array)
        """



    say """
      create               length=$(l.length) contains(1)=$(l.contains 1)
      $l
      $(l.as_array)
      """

    test_add_frst 2

    test_add_last 3

    test_add_frst 5

    test_add_frst 1

    test_add_last 4

    test_add_last 5

    test_rem_frst_mtch %%5

    test_rem_frst_mtch %%9

    test_add_frst 1

    test_rem_frst

    test_rem_last

    test_rem_frst_mtch =3

    test_rem_frst_mtch =2

    test_rem_last

    test_rem_last

    test_rem_frst

    test_rem_last
