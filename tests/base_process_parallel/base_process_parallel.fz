#
#  Source code of Fuzion test base_process_parallel
#
# -----------------------------------------------------------------------

base_process_parallel =>

  # the idea of this test is to tease out
  # concurrency issues of the runtime
  # when starting many processes in parallel

  r := concur.atomic i32 .new 0

  a := concur.thread_pool 8 ()->
    for i in 1..1E2 do
      _ := concur.thread_pool.env.submit _ ()->
        mutate ! ()->
          x := (os.process.start "echo" ["eecchhoo"]).bind ep->
            (ep | ["cat"]).bind cp->
              y := cp.with_out unit mutate ()->
                o := ((io.buffered mutate).read_string 1E9).or_panic
                check o = "eecchhoo\n"
                _ := r.incr
              check y.ok
          check x.ok
  check a.ok

  say r.read
