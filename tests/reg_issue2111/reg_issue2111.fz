test(T type : property.equatable, a T) =>
  a1 := concur.atomic T .new a
  _ := a1.read = a

  on is
  off is
  my_switch : choice on off is
    public redef type.equality(a, b my_switch.this) bool => true
  test my_switch on

# NYI: BUG: #7975: calling `test` will result hanging monomorphization,
# once #7975 is fixed, this should produce an error for recursive types
# if `false` was replaced by `true`
#
if false
  test 42
