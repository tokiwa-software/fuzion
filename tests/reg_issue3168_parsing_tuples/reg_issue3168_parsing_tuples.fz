reg_issue3168_parsing_tuples is

    # Tuple used as actual type parameter requires double parentheses
    # https://github.com/tokiwa-software/fuzion/issues/1382
    s1 Sequence (i64, bool) := [(3,true),(4,false)]; say s1
    s2 Sequence ((i64, bool)) := [(3,true),(4,false)]; say s2


    # AoC issue: Tuple type syntax sugar does not work well as actual type parameter
    # https://github.com/tokiwa-software/fuzion/issues/2377
    _ := array (Sequence (tuple i64 String)) .empty
    _ := array (Sequence (i64, String)) .empty
    lm : mutate is
    lm.instate_self unit ()->
      _ := lm.array (Sequence (tuple i64 String i64)) .new 0 _->[]
      _ := lm.array (Sequence (i64, i64)) .new 0 _->[]


    # tuple type requires double parentheses option ((i64,i64))
    # https://github.com/tokiwa-software/fuzion/issues/3149
    f(x option (i64,i64)) => { say x.or_panic.values.0 }; f (47,11)
