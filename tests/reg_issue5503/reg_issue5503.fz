#
#  Source code of Fuzion test reg_issue5503
#
# -----------------------------------------------------------------------

# test that the number of type parameters in a redefinition is not changed
# compared to the original feature
#
reg_issue5503 =>

  a is
    f(X : Any) =>

  # the original example from #5503
  #
  b : a is
    redef f(x Any) =>   # 1. should flag an error: no type parameters, expecting 1

  # cross-check with a correct redefinition:
  #
  c : a is
    redef f(Y : Any) =>  # ok

  # a more complex example with 3 type parameters and 2 value arguments
  #
  d is
    f(X, Y, Z : Any, v, w i32) =>

  e : d is
    redef f(                    x, y, z Any, v, w i32) =>  # 2. should flag an error: no type parameters, expecting 3

  f : d is
    redef f(X             : Any, y, z    Any, v, w i32) =>  # 3. should flag an error: 1 type parameter, expecting 3

  g : d is
    redef f(X, Y          : Any, z       Any, v, w i32) =>  # 4. should flag an error: 2 type parameters, expecting 3

  h : d is
    redef f(X, Y, Z       : Any,              v, w i32) =>  # ok

  i : d is
    redef f(X, Y, Z, V    : Any,                 w i32) =>  # 5. should flag an error: 4 type parameters, expecting 3

  j : d is
    redef f(X, Y, Z, V, W : Any                       ) =>  # 6. should flag an error: 5 type parameters, expecting 3
