# execute this Sequence of process+args
#
public Sequence.execute(
  # environment variables
  env_vars option (container.Map String String),

  # feed .stdin file to executed process?
  feed_stdin option io.path,

  # maximum time to wait for the execution to finish
  timeout option time.duration
) outcome tokiwa.process_result =>
  seq := map (.as_string)
  ( if env_vars.ok
      os.process.start seq.first.or_panic (seq.drop 1) env_vars.or_panic
    else
      os.process.start seq.first.or_panic (seq.drop 1)
  ).bind p->
    tokiwa.record_process p Sequence.this.as_string timeout feed_stdin


# execute this string by splitting at all whitespaces
#
public String.execute(
  # environment variables
  env_vars option (container.Map String String),

  # feed .stdin file to executed process?
  feed_stdin option io.path,

  # maximum time to wait for the execution to finish
  timeout option time.duration
) outcome tokiwa.process_result =>
  split_if (=" ")
    .map (.replace tokiwa.protected_space " ")
    .execute env_vars feed_stdin timeout


# execute this string by splitting at all whitespaces
#
public String.execute(
  # environment variables
  env_vars option (container.Map String String)
) outcome tokiwa.process_result =>
  String.this.execute env_vars nil nil


# execute this string by splitting at all whitespaces
#
public String.execute outcome tokiwa.process_result =>
  String.this.execute nil nil nil


#
# unit feature grouping tokiwa related code
#
public tokiwa is

  # used for protecting spaces when splitting command string
  #
  public protected_space codepoint =>
    codepoint 0x10ffff # last Unicode codepoint, a noncharacter reserved for internal use


  # stores the results of a process
  #
  public process_result(public out, err String, public exit_code u32) is

    public ok bool => exit_code = 0

    public panic_on_error unit =>
      if !ok then panic "$(exit_code): $(err)"

    public out_or_panic String =>
      if ok then out else panic "$(exit_code): $(err)"


    public type.empty_success tokiwa.process_result =>
      tokiwa.process_result "" "" 0


    public redef as_string String =>
      "$(exit_code): $(out)$(err)"


  # helper to get out, err, exit_code from started process
  #
  public record_process(
        p os.process,
        # the command, for error messages
        cmd String,
        timeout option time.duration,
        # feed file to stdin of executed process?
        feed_stdin option io.path
  ) process_result =>
    lm : mutate is
    (concur.thread_pool 2 ()->
        fout := concur.thread_pool.env.submit _ ()->
          lm ! ()->
            p.with_out String lm (() -> (io.buffered lm).read_fully.bind String.from)
        ferr := concur.thread_pool.env.submit _ ()->
          lm ! ()->
            p.with_err String lm (() -> (io.buffered lm).read_fully.bind String.from)

        match feed_stdin
          nil =>
          stdin_file io.path =>
            if io.file.exists stdin_file
              lm ! ()->
                (p.with_in unit lm ()->
                  (io.buffered lm).Writer.env.write (io.slurp stdin_file).or_panic .or_panic).or_panic

        # do not close in
        # p.close_in.or_panic

        match p.wait (timeout.or_default time.duration.max)
          e error =>
            p.close_out.or_panic
            p.close_err.or_panic
            p.kill     .or_else (say "sending kill signal to $p failed")
            process_result "" "failed waiting for $cmd, error is: $e" 1
          ec u32 =>
            o := fout.get
            e := ferr.get
            p.close_out.or_panic
            p.close_err.or_panic
            process_result $o $e ec)
      .or_panic


reg_issue7379 =>
  for res in ["cat".execute (container.ps_map String String).empty nil (time.duration.s 3) .or_panic,
              "cat".execute (container.ps_map String String).empty (io.path.from "reg_issue7379.fz.stdin") (time.duration.s 3) .or_panic] do
    say <| res.err.substring 0 25

reg_issue7379
