# check that `record_process` gives up on a process that does not terminate
# within the given timeout and reports the command it failed to wait for
#
reg_issue7379 =>

  # the pid in the error message is not deterministic, so only compare the
  # beginning of the message which contains the command
  #
  expected := "failed waiting for [sleep, 1m]"

  for stdin_file in [option (os.cwd.or_panic.resolve "tests/reg_issue7379/reg_issue7379.fz.stdin"), nil] do
    res := "sleep 1m".execute (container.ps_map String String).empty stdin_file (time.duration.s 1) .or_panic

    check !res.ok
    check res.err.starts_with expected

    say <| res.err.substring 0 expected.byte_count

reg_issue7379
