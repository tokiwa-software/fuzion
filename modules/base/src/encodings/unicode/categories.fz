# groups features to look up the General_Category of a code point
#
module categories is

  # cached copy of `unicode.data.category_starts`
  #
  starts array u32 =>
    # cache key
    starts(val array u32) is

    (cache starts (() -> starts unicode.data.category_starts)).val


  # cached copy of `unicode.data.category_indices`
  #
  indices array u8 =>
    # cache key
    indices(val array u8) is

    (cache indices (() -> indices unicode.data.category_indices)).val


  # cached copy of `unicode_category.all`
  #
  all array unicode_category =>
    # cache key
    all(val array unicode_category) is

    (cache all (() -> all unicode_category.all)).val


  # the General_Category of code point `cp`
  #
  # Returns `unassigned` for values that are not valid code points (cp > 0x10ffff).
  #
  # Performs a binary search in `starts`.
  #
  module of(cp u32) unicode_category =>
    s := starts

    # find largest index i in l..r with s[i] <= cp
    #
    # invariant: s[l] <= cp
    #
    find(l, r i64) i64 =>
      if l >= r then l
      else
        m := (l + r + 1) / 2
        if s[m] <= cp then find m r else find l m-1

    if codepoint.range.contains cp
      all[indices[find 0 s.length-1].as_i64]
    else
      unicode_categories.unassigned
