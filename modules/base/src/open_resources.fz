#
#  Source code of Fuzion standard library feature open_resources
#
# -----------------------------------------------------------------------

private:public open_resources (R type : resource, public resources container.Set R) : effect is


  module register_usage(r R) unit =>
    if debug
      if !resources.contains r
        fuzion.runtime.fault.env.cause ("open_resources.register_usage", "resource already closed or owned by another thread.")
      replace


  module close(r R) outcome unit
    pre debug: resources.contains r
  =>
    open_resources (resources ∖ container.set_of_ordered R [r])
      .replace
    r.close_automatically


  module open (r R) unit
    pre debug: !resources.contains r
  =>
    open_resources (resources ∪ container.set_of_ordered R [r])
      .replace


  public redef fixed type.default_value option (open_resources R) =>
    open_resources (container.set_of_ordered R [])


  public redef finally unit =>
    resources
      .sort_by property.reverse_order
      .for_each r->
        # NYI: UNDER DEVELOPMENT: register failures somewhere
        _ := r.close_automatically


