# entry, choice of path, no_more_entries or error
# This is the result type of dir.Read.next
#
private:public entry : choice io.path io.dir.no_more_entries error is

  public redef as_string String =>
    match entry.this
      p io.path => $p
      io.dir.no_more_entries => $io.dir.no_more_entries
      e error => $e
