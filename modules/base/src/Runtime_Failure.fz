# effect to register any failures happening at runtime.
#
# By default this just prints the error to stderr
#
public Runtime_Failure ref : effect is

  public register_failure(e error) unit => abstract

  public redef fixed type.default_value option Runtime_Failure =>
    _ : Runtime_Failure is
      public redef register_failure(e error) unit =>
        io.Err.env.println e

