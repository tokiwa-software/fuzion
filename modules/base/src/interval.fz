# A `from..through` interval with a given `step`.
#
# Generates a sequence by repeatedly adding `step` to `from`.
# Stops before passing `through` (exceeding it for `step > 0`, falling below for `step < 0`).
#
# Empty if `step` points away from `through`:
#     interval 1 2 -1     # empty: steps down, but through is up
#     interval 2 1 1      # empty: steps up, but through is down
#     interval 1 7 3      # 1, 4, 7
#     interval 1 8 3      # 1, 4, 7  (10 would exceed through)
#     interval 7 1 -3     # 7, 4, 1
#     interval 5 5 0      # 5
#
# If `through` is `nil`, the interval is unbounded and limited only by type `T` range.
#
public interval(T type : integer,

                # Start value. Included unless the interval is empty.
                public from T,

                # Inclusive bound. Included only if reachable via `from + n * step`.
                # `nil` means unbounded.
                public through option T,

                # Step size. Positive increments; negative decrements.
                public step T)
  : container.Set T

pre
  debug: ((step.sign = 0): through = from)  # step cannot be zero unless from=through
is


  # Creates a new interval with the `step` multiplied by `step_factor`.
  # `from` and `through` remain unchanged.
  #
  # Since it returns an interval, `infix :` can be chained (factors multiply):
  #     2..10        # {2,4,6,8,10} (implicit step 1 -> new step 2)
  #     (2..12:2):3  # {2,8}        (step becomes 1 * 2 * 3 = 6)
  #
  # A negative `step_factor` reverses the direction. It usually makes the
  # interval empty because `from` and `through` do not change:
  #     2..10: -2     # empty: step points away from `through`
  #
  public infix : (step_factor T) interval T
  pre
    debug: ((step_factor.sign = 0): through=from) # `step_factor` cannot be zero unless `from == through`, because a zero step would never reach `through`.
    safety: (step *? step_factor).exists
  =>
    interval from through step*step_factor


  # the values of this interval as a list, in order
  #
  # Returns an empty list if `step` moves in the opposite direction of `through`.
  #
  # For `step = 0` the result is the single element `from`: the
  # precondition guarantees `from = through` in that case.
  #
  # Otherwise starts at `from` and advances by `step` until `through`
  # is passed or `T` overflows.
  #
  public redef as_list list T =>
    if (through ? nil    => false
                | thru T => from != thru && step.sign = (from ⋄ thru).sign)
      nil
    else
      tail => if step.sign = 0
                nil
              else
                (from+?step ? next T => (interval next through step).as_list
                            | nil    => nil)
      list T .of from tail finite


  # get the number of elements in this interval
  #
  # Performance O(1) in case  through.exists, otherwise O(result)
  #
  public size T
  =>
    match through
      thru T =>
        if from = thru then
          T.one
        else if step.sign = (from ⋄ thru).sign then
          T.zero
        else
          (thru - from) / step + T.one
      nil =>
        T.from_u32 as_list.count.as_u32

  # get the first element of this interval
  #
  # Performance O(1)
  #
  public redef first option T
  =>
    match through
      thru T =>
        if from = thru then
          from
        else if step.sign = (from ⋄ thru).sign then
          nil
        else
          from
      nil =>
        from

  # the last element of this interval, `nil` if there is none
  #
  # There is no last element if the interval is empty or unbounded.
  #
  # Performance: O(1)
  #
  public redef last option T
  =>
    match through
      thru T =>
        if from = thru then
          from
        else if step.sign = (from ⋄ thru).sign then
          nil
        else
          thru-(thru-from)%step
      nil =>
        nil


  # reverse the order of the elements in this interval
  #
  # Performance: O(1)
  #
  public reverse_interval interval T
  pre
    safety: T.zero -! step  # We must be able to negate `step`, so `T` must be signed
    debug: through.exists && first.exists
  =>
    match last
      l T =>
        interval l first -step
      nil =>
        interval T.one T.zero T.one # empty interval


  # does this interval contain the given value?
  #
  # `e` must lie within the bounds and be reachable from `from` by whole
  #
  public redef contains(e T) bool =>
    if      step.sign > 0 then from <= e <= through.or_else e && (e - from) %  step = T.zero
    else if step.sign < 0 then from >= e >= through.or_else e && (e - from) % -step = T.zero
    else                       from =  e


  # string representation of this interval, e.g., "1..10:2"
  #
  # Prints `±∞` for unbounded intervals; omits step if it equals 1.
  #
  public redef as_string String =>
    thru := through.bind ($)
                   .or_else ()->if step.sign < 0 then "-∞" else "∞"
    "$from..$thru$(if step = T.one then "" else ":$step")"


  # create a new interval from a sequence of elements
  #
  public fixed redef type.new (s Sequence T) container.Set T =>
    container.set_of_ordered s


  # is this sequence known to be finite?  For infinite sequences, features like
  # count diverge.
  #
  public redef finite trit =>
    if through.exists then trit.yes else trit.no
