public resource : property.orderable is

  id := unique_id

  open_resources resource.this .env.open resource.this


  #
  # NYI: UNDER DEVELOPMENT: ensure this is called
  # by open_resources effect only
  #
  public close_automatically outcome unit => abstract


  public close outcome unit =>
    open_resources resource.this .env.close resource.this


  # NYI: UNDER DEVELOPMENT: we need sth. like closing order
  public redef type.lteq(a, b resource.this) bool =>
    a.id = b.id
