# Values_Of_Open_Type -- parent feature of type used for open types
#
# This is the parent feature of the result type of fields with open
# type such as `tuple.values` if called without selecting a particular
# variant such as `tuple.values.2`.
#
# The Values_Of_Open_Type value inherits from `TypedSequence` permitting access to
# the types and values of the individual fields
#
module:public Values_Of_Open_Type(# constraint on the types of the values contained in this, `Any` if none.
                                  C : Any
                                 ) ref : container.Typed_Sequence C is


  # fold the actual fields created for a field whose type is an open type parameter
  # using the given `TypeApplicator` `a` and initial value `e`.
  #
  # In case the actual open type parameter list is empty, the result is `e`.
  #
  public redef typed_foldf(E : Any,
                           A : container.typed_applicator C E,
                           e E,
                           a A
                           ) E
  =>

    autogenerated_code_for_Values_Of_Open_Type_fold C E A e a
  /* the auto-generated code for `tuple String f64 bool` looks as follows:

    a.apply bool       (
      a.apply f64        (
        a.apply String     (
                            e
                           ) values.0
                         ) values.1
                       ) values.2

   */


  # zip the elements of this `Typed_Sequence` using the given `Typed_Combiner`
  # and initial value.
  #
  # In case this `Typed_Sequence` is empty, the result is `e`.
  #
  public redef typed_zip_and_fold(E : Any,
                                  Z : Typed_Combiner E E,
                                  other Values_Of_Open_Type.this,
                                  e E,
                                  z Z
                                  ) E
  =>

    autogenerated_code_for_Values_Of_Open_Type_zip C _ _ _ /* Value_Of_Open_Type.this E Z */ other e z

  /* the auto-generated code for `tuple String f64 bool` looks as follows:

    z.apply bool      (
      z.apply f64       (
        z.apply String    (
                           e
                          ) values.0 other.values.0
                        ) values.1 other.values.1
                      ) values.2 other.values.2

   */


# magic intrinsic used by middle end to create code for `typed_foldf`, see above.
#
autogenerated_code_for_Values_Of_Open_Type_fold(# constraint on the types this is applied to, `Any` if none.
                                                C : Any,

                                                # type of cumulative value
                                                E : Any,

                                                # type of the applicator we are specializing for
                                                A : container.typed_applicator C E,

                                                # initial cumulative value
                                                e E,

                                                # the applicator to use on the values
                                                a A
                                               ) E => intrinsic


# magic intrinsic used by middle end to create code for `typed_zip`, see above.
#
autogenerated_code_for_Values_Of_Open_Type_zip(# constraint on the types this is applied to, `Any` if none.
                                               C : Any,

                                               # typeo of the sequence this is applied to
                                               V : container.Typed_Sequence C,

                                               # type of cumulative value
                                               E : Any,

                                               # type of the combiner we are specializing for
                                               Z : Typed_Combiner E E,

                                               # the values we are combining with
                                               other V,

                                               # initial cumulative value
                                               e E,

                                               # the combiner to use on the values and `other`
                                               z Z
                                              ) E => intrinsic
