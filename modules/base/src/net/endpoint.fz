# an endpoint provides access to the peers address and port
#
module:public endpoint(desc i32) : effect
is


  # get the peer's ip address (tcp)
  public get_peer_address outcome net.ip_address =>
    fuzion.sys.net.get_peer_address desc
      .bind net.ip_address.type.from_sequence


  # get the peer's port (tcp)
  public get_peer_port outcome u16 =>
    fzE_get_peer_port desc
