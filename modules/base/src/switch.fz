#  Tokiwa Software GmbH, Germany
#
#  Source code of Fuzion standard library feature switch
#
# -----------------------------------------------------------------------

# switch is the parent feature of all choices
# that encode success and failure,
# e.g.    option  (something/nil)
#      or outcome (something/error)
#
public switch(A type, B type /* NYI: B should be open generic */)
  : choice A B,
    monad A,
    Sequence A,
    property.hashable,
    property.orderable
is

  # Does this switch contain a value of type A?
  #
  public ok bool =>
    match switch.this
      A => true
      B => false


  # shorthand postfix operator for 'ok'
  # NYI: UNDER DEVELOPMENT: rename to just one question mark
  #
  public postfix ?? bool => ok


  # shorthand postfix operator for 'or_panic'
  #
  public postfix ! A ! panic => or_panic


  # shorthand prefix operator for '!ok'
  #
  public prefix ! bool => !ok


  # monadic operator for bool result, false for B
  #
  public infix >>? (f A -> bool) bool
  =>
    switch.this ? a A => f a
                | _ B => false


  # value of a switch or default if switch contains B
  #
  public or_default(default A) A
  =>
    switch.this ? a A => a
                | B   => default


  # synonym for infix >>=
  #
  public and_then (f A -> switch.this) switch.this =>
    match switch.this
      a A => f a
      b B => b


  # returns o if switch is of type A, otherwise return the
  # switches B.
  #
  public and (O type, o switch.this) switch.this =>
    match switch.this
      A   => o
      b B => b


  # if this switch is a B return the result of f
  # otherwise just return this switch.
  #
  public or (f Lazy switch.this) switch.this =>
    match switch.this
      a A => a
      B   => f()


  # unwraps a switch if it exists, returns default value otherwise.
  #
  public or_else(default Lazy A) A =>
    switch.this ? v A => v
                |   B => default



  # value of a switch, or, if this switch contains a `B`, the
  # result of `f` applied to that `B`.
  #
  # in contrast to `or_else`, `f` receives the `B` value, so this can be
  # used to handle a failure without a `match`, e.g. to log an error
  # that cannot be propagated:
  #
  # example:
  #
  #     (fuzion.sys.fileio.close fd)
  #       .otherwise Ignored_Failure.env.register_failure
  #
  public otherwise(f B -> A) A =>
    match switch.this
      a A => a
      b B => f b


  # converts switch into a list of either a single element in case
  # switch.this.ok or `nil` otherwise
  #
  public redef as_list list A
  =>
    switch.this ? a A => a : nil
                | B => nil


  # convert this switch to an option
  #
  public as_option option A
  =>
    switch.this ? a A => a
                | B => nil


  # convert this switch to an outcome
  #
  public as_outcome outcome A
  =>
    switch.this ? a A => a
                | B => error "converted to outcome from '$(switch.this.type.name)' with no error message provided"


  # convert this switch to an outcome
  #
  public as_outcome(e error) outcome A
  =>
    switch.this ? a A => a
                | B => e


  # monadic operator
  #
  public redef infix >>= (f A -> switch.this) switch.this =>
    switch.this ? a A => f a
                | b B => b


  # return function
  #
  public redef fixed type.return (a A) switch A B => a


  # get A or cause an `exception T`
  #
  public or_cause(T type, e B->error) A ! flow.exception T =>
    match switch.this
      a A => a
      b B => (flow.exception T).env.cause (e b)


  # get A or panic with `B.as_string`
  #
  public or_panic A =>
    or_panic b->"'or_panic' called on '$(switch.this.type.name)' that is '$b'"


  # get A or panic with result of `msg`
  #
  public or_panic(msg B->String) A =>
    match switch.this
      a A => a
      b B => panic (msg b)


  # fold this choice to new type `C`.
  #
  # this is useful when you don't want to break
  # fluent-style code.
  #
  # example:
  #
  #     "haystack"
  #       .find "needle"
  #       .fold (idx -> "found needle at {idx}") (_ -> "could not find needle")
  #
  #
  public fold(C type, fa A->C, fb B->C) C =>
    match switch.this
      a A => fa a
      b B => fb b


  # converts switch to a string
  #
  public redef as_string String =>
    match switch.this
      a A => $a
      b B => $b


  # generic equality implementation for switch
  #
  # a switch is only equal if x and y wrap the same type and
  # the wrapped values are themselves equal
  #
  public redef type.equality(x, y switch.this) bool
  =>
    if A : property.equatable
      if B : property.equatable
        match x
          ax A =>
            match y
              ay A => ax = ay
              B    => false
          bx B =>
            match y
              A    => false
              by B => bx = by
      else
        compile_time_panic
    else
      compile_time_panic


  # defines a generic total order for switch
  #
  # - switches wrapping the same type use the lteq
  #   implementation of the corresponding type
  # - switches wrapping an A are considered lower
  #   than switches wrapping a B
  #
  public redef type.lteq(x, y switch.this) bool
  =>
    if A : property.orderable
      if B : property.orderable
        match x
          ax A =>
            match y
              ay A => A.lteq ax ay
              B    => true
          bx B =>
            match y
              A    => false
              by B => B.lteq bx by
      else
        compile_time_panic
    else
      compile_time_panic


  # generic hash_code implementation for switch
  #
  public redef type.hash_code(s switch.this) u64
  =>
    if A : property.hashable
      if B : property.hashable
        match s
          # random 64-bit values generated via https://cryptotools.dev/
          a A => A.xxh_next 0xfc99d7cd2ae81da9 (A.hash_code a)
          b B => B.xxh_next 0xa59ebdb824e870a7 (B.hash_code b)
      else
        compile_time_panic
    else
      compile_time_panic
