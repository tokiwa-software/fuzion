# time.Thread_CPU_Time -- clock providing access to the CPU time consumed by a
# given thread
#
# In contrast to `time.Thread_Time`, which reads the CPU time of the current
# thread, this can be used to read the CPU time of any thread, e.g., to
# regularly check the CPU time budget of another thread.
#
# This clock advances only while `thread` is running, so it cannot be used
# to sleep. It cannot be read any longer once `thread` was joined.
#
# NYI: UNDER DEVELOPMENT: #8417: using a clock is an effect that must be
# visible to DFA.
#
public Thread_CPU_Time(thread concur.Thread) ref : time.Clock is


  # read the CPU time consumed by `thread` so far
  #
  public redef read time.instant
  =>
    ns := thread.cpu_time_ns
    if ns < 0
      panic "failed to read CPU time of $thread"
    time.instant ns.as_u64


  # sleeping is not possible on a CPU time clock
  #
  public redef sleep(d time.duration) unit
  =>
    panic "time.Thread_CPU_Time cannot be used to sleep"
