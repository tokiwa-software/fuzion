# cpu_time -- CPU time consumed, a proxy for energy use
#
public cpu_time is

  # CPU time consumed by the current thread so far
  #
  public thread time.duration =>
    time.duration (fzE_posix_time (id posix.clockid_t posix.clock_thread_cputime).val)

  # CPU time consumed by the current process so far
  #
  public process time.duration =>
    time.duration (fzE_posix_time (id posix.clockid_t posix.clock_process_cputime).val)

  # run f and return the CPU time the current thread spent in it
  #
  public measure(f ()->unit) time.duration =>
    s := thread
    f()
    thread - s
