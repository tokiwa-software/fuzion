# time.Thread_Time -- effect providing access to the CPU time of the current thread
#
# This clock advances only while the current thread is running, so it
# cannot be used to sleep.
#
public Thread_Time ref : posix_clock is


  # This clock corresponds to POSIX 1003.1's CLOCK_THREAD_CPUTIME_ID
  #
  public redef type.posix_id option posix.clockid_t
  =>
    posix.clock_thread_cputime


  # sleeping is not possible on a CPU time clock
  #
  public redef sleep(d time.duration) unit
  =>
    panic "time.Thread_Time cannot be used to sleep"


  # default implementation of time.Thread_Time.
  #
  public redef fixed type.default_value option time.Thread_Time
  =>
    time.Thread_Time
