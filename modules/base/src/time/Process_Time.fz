# time.Process_Time -- effect providing access to the CPU time of the current process
#
# This is the CPU time consumed by all threads of the process, including
# threads that have already terminated. It cannot be used to sleep.
#
public Process_Time ref : posix_clock is


  # This clock corresponds to POSIX 1003.1's CLOCK_PROCESS_CPUTIME_ID
  #
  public redef type.posix_id option posix.clockid_t
  =>
    posix.clock_process_cputime


  # sleeping is not possible on a CPU time clock
  #
  public redef sleep(d time.duration) unit
  =>
    panic "time.Process_Time cannot be used to sleep"


  # default implementation of time.Process_Time.
  #
  public redef fixed type.default_value option time.Process_Time
  =>
    time.Process_Time
