# is `a` contained in `Set` `s`?
#
# This should usually be called using type inference as in
#
#     my_set := set_of ["A","B","C"]
#     say <| "B" ∈ my_set
#     say <| "D" ∈ my_set
#
public infix ∈ (T type : property.equatable,
                a T,
                s container.Set T) bool
=>
  s.contains a


# is `a` not contained in `Set` `s`?
#
# This should usually be called using type inference as in
#
#     my_set := set_of ["A","B","C"]
#     say <| "B" ∉ my_set
#     say <| "D" ∉ my_set
#
public infix ∉ (T type : property.equatable,
                a T,
                s container.Set T) bool
=>
  !(s.contains a)
