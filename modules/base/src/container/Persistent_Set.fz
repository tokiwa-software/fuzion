# Persistent_Set -- an abstract persistent set from keys K
#
public Persistent_Set(K : property.equatable) ref : container.Set K is

  # returns a new Persistent_Set
  # which contains all entries of the
  # current Set and k.
  #
  public put(k K) Persistent_Set.this => abstract
