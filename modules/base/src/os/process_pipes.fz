#
# -----------------------------------------------------------------------

# os.process_pipes -- records which pipes of a process were closed already
#
# This is a ref, so all copies of an `os.process` share it.  This permits
# closing each pipe exactly once, also if `close_in`, etc. are called several
# times or `os.Process.finally` closes the pipes that are still open.
#
module process_pipes ref is

  # has std_in, std_out or std_err, respectively, been closed already?
  #
  module in_closed  := concur.atomic bool .new false
  module out_closed := concur.atomic bool .new false
  module err_closed := concur.atomic bool .new false
