# os.Process_State -- internal state of a process, shared by all copies of
# an `os.process`
#
# NYI: once #8369 provides global state for the `Process` effect, this should
# be stored in a map in that global state instead.
#
module Process_State ref is

  # has std_in, std_out or std_err, respectively, been closed already?
  #
  module in_closed  := concur.atomic bool .new false
  module out_closed := concur.atomic bool .new false
  module err_closed := concur.atomic bool .new false
