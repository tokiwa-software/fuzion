# get the hostname
#
public hostname outcome String =>
  arr := array u8 _ 256 _->0
  len := fzE_hostname arr.internal_array.data arr.count

  if len < 0
    error "hostname failed" fzE_last_error
  else
    String.from_bytes (arr.slice 0 len)
