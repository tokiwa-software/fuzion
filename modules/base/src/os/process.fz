# type denoting a started process
#
module:public process(public pid i64, module std_in, std_out, std_err i64, name String, args Sequence String) : property.orderable is


  # predefined read handler for reading from
  # standard out of the process
  #
  std_out_reader(LM type : mutate) => pipe_reader LM std_out "reading from stdout(desc=$std_out) of process $(pid)"


  # predefined read handler for reading from
  # standard err of the process
  #
  std_err_reader(LM type : mutate) => pipe_reader LM std_err "reading from stderr(desc=$std_err) of process $(pid)"


  # predefined write handler for writing to
  # standard in of the process
  #
  std_in_writer(LM type : mutate) => pipe_writer LM std_in "writing to stdin(desc=$std_in) of process $(pid)"


  # read bytes from standard out
  # NYI: CLEANUP: remove this
  #
  read_handler(desc i64) is
    public read(max_count i32) choice (Sequence u8) io.end_of_file error =>
      arr := array u8 _ io.buffer_size.as_i32 _->0
      res := fzE_pipe_read desc arr.internal_array.data arr.count
      if res = -1
        error "reading from stdout of process $(pid)" fzE_last_error
      else if res = 0
        io.end_of_file
      else
        arr
          .slice 0 res



  # install buffered reader for reading from stdout of process
  # and run `f`.
  public with_out(T type, LM type : mutate, f () -> outcome T) outcome T =>
    (io.buffered LM).Reader.instate (std_out_reader LM) f


  # install buffered reader for reading from stdout of process
  # and run `f`.
  public with_err(T type, LM type : mutate, f () -> outcome T) outcome T =>
    (io.buffered LM).Reader.instate (std_err_reader LM) f


  public with_in(T type, LM type : mutate, f () -> T) outcome T =>
    (io.buffered LM).Writer.instate (std_in_writer LM) f


  # pipe this processes output to new process
  #
  public infix | (process_and_args Sequence String) outcome os.process ! os.Process
  pre
    process_and_args ∀ .is_ascii
    !process_and_args[0].contains_whitespace
  =>
    (os.process.start process_and_args.first.or_panic (process_and_args.drop 1)).bind p->

      # NYI: UNDER DEVELOPMENT: should wire pipe directly to process
      # NYI: UNDER DEVELOPMENT: this works only when pipes buffer is large enough for
      # what is being written/read to/from pipes
      # thread to pipe from one process to other
      _ := concur.Threads.env.spawn ()->
        for p1rb := (read_handler std_out).read io.buffer_size.as_i32
        while
          match p1rb
            s Sequence =>
              lm : mutate is
              lm ! ()->
                _ := p.with_in unit lm ()->
                  _ := (io.buffered lm).Writer.env.write s
                true
            io.end_of_file => false
            e error => panic e

        # NYI: UNDER DEVELOPMENT: error handling
        _ := fzE_pipe_close p.std_in
        _ := fzE_pipe_close process.this.std_out
        _ := fzE_pipe_close process.this.std_err

      p


  # close standard input of this process
  #
  public close_in outcome unit =>
    if fzE_pipe_close std_in != 0
      error "closing stdin of process $(pid)" fzE_last_error


  # close standard output of this process
  #
  # NYI: CLEANUP: should this better be done automatically by runtime?
  #
  public close_out outcome unit =>
    if fzE_pipe_close std_out != 0
      error "closing stdout of process $(pid)" fzE_last_error


  # close standard error of this process
  #
  # NYI: CLEANUP: should this better be done automatically by runtime?
  #
  public close_err outcome unit =>
    if fzE_pipe_close std_err != 0
      error "closing stderr of process $(pid)" fzE_last_error


  # wait for this process
  #
  public wait outcome u32 ! time.Nano, os.Process =>
    wait time.duration.max


  # wait for this process
  #
  public wait(timeout time.duration) outcome u32 ! time.Nano, os.Process
  =>
    # NYI: UNDER DEVELOPMENT:
    # with fixed this should be possible:
    # os.Process.env.wait process.this timeout
    os.Process.env.wait (os.process pid std_in std_out std_err name args) timeout


  # send signal to process
  #
  public send_signal(sig os.signal) outcome unit =>
    # NYI: UNDER DEVELOPMENT:
    # with fixed this should be possible:
    # os.Process.env.send_signal process.this sig
    os.Process.env.send_signal (os.process pid std_in std_out std_err name args) sig


  # send kill signal to process
  #
  public kill outcome unit =>
    send_signal os.signals.kill


  # send terminate signal to process
  #
  public terminate outcome unit =>
    send_signal os.signals.terminate


  # start a process with name, arguments and environment variables
  #
  public type.start(n String, args Sequence String, env_vars container.Map String String) outcome os.process ! os.Process
  =>
    os.Process.env.start n args env_vars


  # start a process with name and arguments
  #
  public type.start(n String, args Sequence String) outcome os.process ! os.Process =>
    start n args (container.ps_map String String).empty


  # start a process with name and no arguments
  #
  public type.start(n String) outcome os.process ! os.Process =>
    start n []


  # equality
  #
  public fixed redef type.equality(a, b process.this) bool => a.pid = b.pid


  # lteq
  #
  public fixed redef type.lteq(a, b process.this) bool =>
    a.pid <= b.pid


  # this process as a human readable String
  #
  public redef as_string String ! time.Nano, os.Process =>
    match wait time.duration.zero
      error  => "$name $(String.join args " ") (running, PID: $pid)"
      ec u32 => "$name $(String.join args " ") (exited with exit code: $ec)"


  # NYI: UNDER DEVELOPMENT:
  # - check if process is still running
  # - send signal to process
  # - get the exit code from a process?
  # - change nice level
  # - ...
