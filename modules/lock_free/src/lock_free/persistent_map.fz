#
# the lock free persistent map type that is created by lock_free.Map.as_persistent_map
#
module:public persistent_map(CTK : property.hashable, CTV : Any, s lock_free.Map CTK CTV) : container.Persistent_Map CTK CTV is
  public redef size i64 => s.size
  public redef index [] (k CTK) option CTV => s[k]
  public redef items Sequence (tuple CTK CTV) => s.items
  public redef fixed put(k CTK, v CTV) persistent_map CTK CTV =>
    ss := (s.snapshot false)
    ss.put k v
    persistent_map ss
