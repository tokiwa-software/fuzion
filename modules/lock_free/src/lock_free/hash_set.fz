# hash_set -- a Set implementation based on lock_free.Map
#
public hash_set(K type : property.hashable, map lock_free.Map K unit) : container.Set K is


  # does this set contain the given value?
  #
  public redef contains (k K) bool =>
    map[k].ok


  # list representation of values in this set
  #
  public redef as_list list K =>
    map.keys.as_list


  # add new element k to this set.
  #
  # NYI: UNDER DEVELOPMENT: this should be integrated in the mutate effect!
  #
  public fixed redef add (k K) container.Set K =>
    ss := map.snapshot false
    ss.put k unit
    hash_set ss


  # remove an element k from the set if it exists.
  # return the same set if it does not exist.
  #
  public remove (k K) container.Set K =>
    ss := map.snapshot false
    _ := ss.remove k
    hash_set ss


  # create a new Set from a sequence of elements
  #
  public fixed redef type.new (s Sequence K) container.Set K =>
    lock_free.hash_set ((lock_free.Map K unit).from_entries (s.map (k -> tuple k unit)))

